# For running `npm run dev` outside Docker. Production values come from your
# platform's secret manager (see docs/DEPLOY.md); never commit a real .env.
NODE_ENV=development
BASE_URL=http://localhost:8080
MODE=self_hosted
OWNER_EMAIL=owner@example.com
DATABASE_URL=postgres://agentkeyring:dev-only-password@localhost:5544/agentkeyring
GOOGLE_ISSUER=http://localhost:8091
GOOGLE_CLIENT_ID=dev-client
GOOGLE_CLIENT_SECRET=dev-client-secret
KMS_PROVIDER=local
LOCAL_KMS_KEY_FILE=.data/local-kms.key
